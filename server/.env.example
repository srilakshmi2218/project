# Server Configuration
PORT=5000
JWT_SECRET=super_secret_call_center_jwt_key_2026

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/call_center?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/call_center

# Telephony Provider (Twilio API Configuration)
# If provided, real phone calls will be initiated via Twilio.
# If left blank or empty, system automatically uses Built-in Telephony Simulator for seamless testing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public Base URL for Webhooks (Optional for production / ngrok)
BASE_URL=http://localhost:5000

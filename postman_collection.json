		{
			"name": "2. Register Agent",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.environment.set('agent_token', jsonData.token);",
							"    pm.globals.set('agent_token', jsonData.token);",
							"    console.log('Saved agent_token:', jsonData.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Sarah Jenkins\",\n  \"email\": \"agent.sarah@callcenter.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Senior Agent\"\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/auth/register",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"api",
						"auth",
						"register"
					]
				}
			},
			"response": []

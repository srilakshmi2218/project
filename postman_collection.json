							"var jsonData = pm.response.json();",
							"if (jsonData.call && jsonData.call.telephonyCallId) {",
							"    pm.environment.set('telephony_call_id', jsonData.call.telephonyCallId);",
							"    pm.globals.set('telephony_call_id', jsonData.call.telephonyCallId);",
							"}"
